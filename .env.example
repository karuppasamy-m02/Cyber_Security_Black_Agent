# ==============================================================================
# CYBERSENTINEL AI - ENVIRONMENT CONFIGURATION
# Intelligent Defense. Explainable Intelligence. Local AI.
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
VERSION=1.0.0
DEBUG=True

# Network Host & Port
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# JWT Authentication & Argon2 Security
SECRET_KEY=CyberSentinelSuperSecretProductionReadyKey2026!ChangeMeBeforeDeploy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite Database
# Path relative to backend root or absolute path
DATABASE_PATH=database/cybersentinel.db

# Local Ollama AI Brain Configuration
# Strictly targets local inference. No cloud API keys required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3:8b
OLLAMA_ALTERNATIVE_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60.0

# Machine Learning & Knowledge Base Paths
MODEL_ARTIFACTS_DIR=ml-engine/models
KNOWLEDGE_BASE_DIR=knowledge-base

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
